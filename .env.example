# Copy to `.env` and fill in for local `wrangler dev`.
# In production these are set with `npx wrangler secret put <NAME>`.
#
# Wrangler loads `.env`, then `.env.local`, then — with `--env <name>` —
# `.env.<name>` and `.env.<name>.local`, each overriding the last. Everything
# but this example file is gitignored. (A `.dev.vars`, if one exists, wins over
# all of them; this project uses `.env`, so keep a single file.)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Gatekeeper identity key for remote (custom) A2A agents — zero-trust, no shared secrets.
# Generate with: npm run keygen
# Then set the printed private JWK as GATEKEEPER_JWT_PRIVATE_KEY (see instructions above).
GATEKEEPER_JWT_PRIVATE_KEY=

