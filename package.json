{
  "name": "slack-gatekeeper",
  "version": "1.0.0",
  "private": true,
  "description": "Slack Agent Template: Cloudflare hosted, Slack-anchored multi-agent gatekeeper with A2A routing",
  "keywords": [
    "agents",
    "ai",
    "cloudflare",
    "slack"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "keygen": "node scripts/generate-gatekeeper-key.mjs",
    "cf": "node scripts/cf.mjs",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply da-registry --local",
    "db:migrate": "wrangler d1 migrations apply da-registry --remote",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "wrangler types --check && prettier --check . && eslint . && tsc && tsc -p test/tsconfig.json && node scripts/check-storage-reset.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@chat-adapter/slack": "^4.41.1",
    "@cloudflare/think": "^0.20.0",
    "@dynamicagents/core": "^0.13.1",
    "@dynamicagents/g2a-protocol": "^0.4.2",
    "agents": "^0.26.0",
    "ai": "^7.0.130",
    "chat": "^4.41.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "slackify-markdown": "github:dynamicagents/slackify-markdown#5.0.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/node": "^26.6.4",
    "@typescript-eslint/utils": "^8.71.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "@mongodb-js/zstd": false,
    "core-js-pure": false,
    "fsevents": false,
    "sharp": false,
    "workerd": false
  }
}
